---
# Canary value: validates that hiera-eyaml is functional on every puppet run.
# If catalog compilation fails with "hiera_eyaml library is not present", an
# agent or puppetserver package upgrade has broken eyaml compatibility.
# See: https://github.com/OpenVoxProject/puppet-runtime/pull/126
profile::base::eyaml_secret: ENC[PKCS7,]
